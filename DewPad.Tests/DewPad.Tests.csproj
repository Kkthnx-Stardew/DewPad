<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The logic in Core has no game dependencies, so the tests compile it directly. -->
    <Compile Include="..\DewPad\Core\*.cs" LinkBase="Core" />
    <None Include="..\DewPad\i18n\default.json" Link="i18n\default.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
