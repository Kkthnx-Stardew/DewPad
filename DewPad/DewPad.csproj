<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>DewPad</RootNamespace>
		<AssemblyName>DewPad</AssemblyName>
		<Version>0.1.0-beta.1</Version>
		<!-- read only overlay, so Harmony is not referenced -->
		<EnableHarmony>false</EnableHarmony>
		<!-- builds never copy into the live Mods folder, which holds a large unrelated mod list -->
		<EnableModDeploy>false</EnableModDeploy>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
	</ItemGroup>
</Project>
