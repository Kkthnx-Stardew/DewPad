<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>DewPad</RootNamespace>
		<AssemblyName>DewPad</AssemblyName>
		<Version>0.1.0-beta.5</Version>
		<!-- read only overlay, so Harmony is not referenced -->
		<EnableHarmony>false</EnableHarmony>
		<!-- builds never copy into the live Mods folder, which holds a large unrelated mod list -->
		<EnableModDeploy>false</EnableModDeploy>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.4.0" />
		<!-- the game's own copy of the Steam library, only to ask whether this is a Steam Deck the way the game does. Never copied into the mod folder -->
		<Reference Include="Steamworks.NET" HintPath="$(GamePath)\Steamworks.NET.dll" Private="false" />
	</ItemGroup>
</Project>
